name = "{{.Category}}-{{.Pkg}}"
description = "Protos the {{.Pkg}} capability's SDK is generated from"
proto_out_dir = ".deps"

# The revision is the commit of what generate/go.mod requires of the capabilities repo's libs: generating keeps it
# there. The releases the SDK generates from are in the production directory, at their versioned path, which never
# changes. The base protos come with them, at the commit the capabilities repo pins, which go.mod's
# chainlink-protos/cre/go follows.
[capabilities]
url = "github.com/smartcontractkit/capabilities"
revision = "{{.Revision}}"
content_roots = ["/{{.CapabilityDir}}/protos/production/capabilities/{{.Category}}/{{.Pkg}}/v{{.MajorVersion}}"]
